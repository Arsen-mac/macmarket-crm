generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN MANAGER CASHIER WAREHOUSE }
enum ProductStatus { ACTIVE ARCHIVED }
enum OrderStatus { NEW CONFIRMED PAID READY COMPLETED CANCELLED }
enum PaymentStatus { PENDING PAID REFUNDED }
enum StockMovementType { RECEIPT SALE RESERVE RELEASE ADJUSTMENT RETURN }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(CASHIER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sales Sale[]
}
model Warehouse {
  id String @id @default(cuid())
  name String
  address String?
  stocks Stock[]
  movements StockMovement[]
  createdAt DateTime @default(now())
}
model Product {
  id String @id @default(cuid())
  sku String @unique
  name String
  brand String
  category String
  price Decimal @db.Decimal(14,2)
  cost Decimal @db.Decimal(14,2)
  status ProductStatus @default(ACTIVE)
  stock Stock[]
  orderItems OrderItem[]
  saleItems SaleItem[]
  movements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Stock {
  id String @id @default(cuid())
  productId String
  warehouseId String
  quantity Int @default(0)
  reserved Int @default(0)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  warehouse Warehouse @relation(fields:[warehouseId], references:[id], onDelete:Cascade)
  @@unique([productId, warehouseId])
}
model StockMovement {
  id String @id @default(cuid())
  productId String
  warehouseId String
  type StockMovementType
  quantity Int
  note String?
  product Product @relation(fields:[productId], references:[id])
  warehouse Warehouse @relation(fields:[warehouseId], references:[id])
  createdAt DateTime @default(now())
}
model Client {
  id String @id @default(cuid())
  name String
  phone String @unique
  email String?
  note String?
  orders Order[]
  sales Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Order {
  id String @id @default(cuid())
  number String @unique
  clientId String?
  status OrderStatus @default(NEW)
  total Decimal @db.Decimal(14,2) @default(0)
  client Client? @relation(fields:[clientId], references:[id])
  items OrderItem[]
  payment Payment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  quantity Int
  price Decimal @db.Decimal(14,2)
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id])
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  amount Decimal @db.Decimal(14,2)
  method String
  status PaymentStatus @default(PENDING)
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Sale {
  id String @id @default(cuid())
  number String @unique
  clientId String?
  userId String
  total Decimal @db.Decimal(14,2)
  client Client? @relation(fields:[clientId], references:[id])
  user User @relation(fields:[userId], references:[id])
  items SaleItem[]
  createdAt DateTime @default(now())
}
model SaleItem {
  id String @id @default(cuid())
  saleId String
  productId String
  quantity Int
  price Decimal @db.Decimal(14,2)
  sale Sale @relation(fields:[saleId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id])
}
